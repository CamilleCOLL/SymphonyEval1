{% extends 'base.html.twig' %}

{% block title %}Inscriptions{% endblock %}

{% block body %}
    <div class="container my-4">
        <h1 class="mb-4">Évènements ouverts à l'inscription :</h1>

        <div class="card mb-4 text-center" style="max-width: 250px;">
            <div class="card-body">
                <h5 class="card-title">Évènements disponibles : </h5>
                <h2>{{ events|length }}</h2>
            </div>
        </div>

        <div class="d-flex flex-column gap-3">
            {% for item in events %}
                {{ include('components/card_event.html.twig', {e: item}) }}
            {% else %}
                <p>Aucun évènement trouvé.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
